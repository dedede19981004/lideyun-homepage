---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/utils';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="博客">
  <div class="container">
    <header class="page-head">
      <h1>博客</h1>
      <p class="sub">Blog — Notes on AI Evaluation</p>
    </header>

    <div class="post-list">
      {posts.map((p) => (
        <a class="post-row" href={`/blog/${p.id}/`}>
          <span class="post-date">{formatDate(p.data.date)}</span>
          <div>
            <h3 class="post-title">{p.data.title}</h3>
            <p class="post-desc">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <div class="post-tags">
                {p.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
