---
interface Props {
  index?: string;
  en: string;
  zh?: string;
}
const { index, en, zh } = Astro.props;
---
<div class="sec-head" data-reveal>
  {index && <span class="sec-idx">{index}</span>}
  <span class="sec-en">{en}</span>
  <span class="sec-line"></span>
  {zh && <span class="sec-zh">{zh}</span>}
</div>

<style>
  .sec-head { display: flex; align-items: center; gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-idx {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--ink);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.05em;
  }
  .sec-en { font-family: var(--mono); font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase; white-space: nowrap; }
  .sec-line { flex: 1; height: 1px; background: var(--line); }
  .sec-zh { font-family: var(--serif); font-size: 15px; color: var(--ink-soft); white-space: nowrap; }
</style>
