---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="f-name">{profile.nameZh}</p>
        <p class="f-sub">{profile.nameEn} — {profile.titleEn}</p>
        <p class="f-loc">Shanghai · China</p>
      </div>
      <nav class="footer-nav">
        <p class="f-h">Menu</p>
        <a href="/about">关于 About</a>
        <a href="/projects">项目 Projects</a>
        <a href="/blog">博客 Blog</a>
        <a href="/timeline">时间线 Timeline</a>
        <a href="/contact">联系 Contact</a>
      </nav>
      <div class="footer-contact">
        <p class="f-h">Get in Touch</p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="#top">Back to Top ↑</a>
      </div>
    </div>
    <p class="footer-watermark" aria-hidden="true">LI DEYUN</p>
    <div class="footer-bottom">
      <span>© {year} {profile.nameEn} · All Rights Reserved</span>
      <span>Designed & Built with Astro · Hosted on GitHub Pages</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--black); color: var(--white); margin-top: clamp(5.5rem, 10vw, 8.5rem); }
  .footer-inner { max-width: 1240px; margin: 0 auto; padding: clamp(4rem, 8vw, 6rem) var(--pad) 2.4rem; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 3.5rem; }
  .f-name { font-family: var(--serif); font-size: 1.9rem; font-weight: 600; }
  .f-sub { font-family: var(--mono); font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--white-soft); margin-top: 0.5rem; }
  .f-loc { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--white-soft); margin-top: 0.3rem; }
  .footer-nav, .footer-contact { display: flex; flex-direction: column; gap: 0.7rem; align-items: flex-start; }
  .f-h { font-family: var(--mono); font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--white-soft); margin-bottom: 0.7rem; }
  .footer-nav a, .footer-contact a {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--white);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease), opacity 0.25s;
  }
  .footer-nav a:hover, .footer-contact a:hover { border-bottom-color: var(--white); }
  .footer-contact a { font-size: 11.5px; }
  .footer-watermark {
    font-family: var(--latin);
    font-weight: 700;
    font-size: clamp(3.6rem, 13vw, 10.5rem);
    line-height: 1;
    letter-spacing: 0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(244, 242, 237, 0.16);
    margin-top: 3.5rem;
    user-select: none;
    white-space: nowrap;
    overflow: hidden;
  }
  .footer-bottom {
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(244, 242, 237, 0.16);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--white-soft);
    text-transform: uppercase;
  }
  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
